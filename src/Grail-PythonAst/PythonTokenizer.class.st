{ #category : 'Grail-Identifiers' }
PythonTokenizer class >> ___ranges___: ranges include: cp [
	"Binary search of a flattened, ascending (first last first last ...) range
	table for code point cp."

	| lo hi mid |
	lo := 1.
	hi := ranges size // 2.
	[lo <= hi] whileTrue: [
		mid := (lo + hi) // 2.
		cp < (ranges at: mid * 2 - 1)
			ifTrue: [hi := mid - 1]
			ifFalse: [
				cp > (ranges at: mid * 2)
					ifTrue: [lo := mid + 1]
					ifFalse: [^ true]]].
	^ false

]

