{ #category : 'Grail-Unicode Case' }
CharacterCollection class >> ___pyCaseMap___: aMappingSelector [
	"The full case mapping the generated table aMappingSelector holds, as a
	dictionary from a code point to the code points it maps to.  Built once a
	session: the table lists only the code points the mapping changes."

	| maps map |
	maps := SessionTemps current at: #GrailCaseMaps otherwise: nil.
	maps ifNil: [
		maps := IdentityKeyValueDictionary new.
		SessionTemps current at: #GrailCaseMaps put: maps].
	map := maps at: aMappingSelector otherwise: nil.
	map ifNil: [
		map := self ___pyCaseMapFrom___: (self perform: aMappingSelector).
		maps at: aMappingSelector put: map].
	^ map

]

{ #category : 'Grail-Unicode Case' }
CharacterCollection class >> ___pyCaseMapFrom___: aTable [
	"aTable read as scripts/generate_unicode_case_data.py writes it: a code
	point, a count, and that many code points, again and again."

	| map index count |
	map := IntegerKeyValueDictionary new.
	index := 1.
	[index <= aTable size] whileTrue: [
		count := aTable at: index + 1.
		map at: (aTable at: index) put: (aTable copyFrom: index + 2 to: index + 1 + count).
		index := index + 2 + count].
	^ map

]

{ #category : 'Grail-Unicode Data' }
CharacterCollection class >> ___pyCodePoint___: cp inRanges: ranges [
	"Is cp in ``ranges'', one of the Numeric_Type tables in
	unicode_char_types.gs?  ASCII is answered without the search -- every
	such table holds exactly 48-57 below 128 -- because that is nearly every
	character these predicates see."

	cp < 128 ifTrue: [^ cp >= 48 and: [cp <= 57]].
	^ self ___pySearchCodePoint___: cp inRanges: ranges

]

