{ #category : 'Grail-Unicode Data' }
CharacterCollection class >> ___pySearchCodePoint___: cp inRanges: ranges [
	"Binary search: is cp in ``ranges'', a sorted literal Array of inclusive
	(first last) pairs from unicode_char_types.gs?"

	| lo hi mid |
	lo := 1.
	hi := ranges size // 2.
	[lo <= hi] whileTrue: [
		mid := (lo + hi) // 2.
		cp < (ranges at: mid * 2 - 1)
			ifTrue: [hi := mid - 1]
			ifFalse: [
				cp > (ranges at: mid * 2)
					ifTrue: [lo := mid + 1]
					ifFalse: [^ true]]].
	^ false

]

