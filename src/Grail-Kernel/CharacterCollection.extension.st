{ #category : 'Grail-String Methods' }
CharacterCollection >> ___formatPad___: count with: fillChar [
	"Return a `count`-long string of `fillChar`s.  Helper for
	___applyAlignWidthFormat___ — GemStone's String class doesn't
	expose ``new:withAll:'', so use the two-step new+atAllPut form."

	| s |
	count <= 0 ifTrue: [^ ''].
	s := String new: count.
	s atAllPut: fillChar.
	^ s

]

{ #category : 'Grail-Testing' }
CharacterCollection >> ___isExactPyStr___ [
	"See object >> ___isExactPyStr___.  True for the KERNEL string classes
	only: a user ``class Markup(str)'' allocates a CharacterCollection
	subclass and may override __eq__ / __lt__ / __radd__, so it must keep the
	reflected-operand priority CPython gives it."

	| c |
	c := self class.
	^ (c == Unicode7)
		or: [(c == Unicode16)
		or: [(c == Unicode32)
		or: [(c == String) or: [c == Symbol]]]]

]

{ #category : 'Grail-Testing' }
CharacterCollection >> ___isPyStr___ [
	"True: every CharacterCollection is a Python str."

	^ true

]

{ #category : 'Grail-String Methods' }
CharacterCollection >> ___lstripChars___: chars [
	"Helper: strip leading occurrences of any character in `chars'."

	| size i |
	size := self size.
	i := 1.
	[i <= size and: [chars includes: (self at: i)]] whileTrue: [
		i := i + 1].
	^ i = 1 ifTrue: [self] ifFalse: [self copyFrom: i to: size]

]

{ #category : 'Grail-Unicode Case' }
CharacterCollection >> ___pyCapitalized___ [
	"str.capitalize(): the first character's full titlecase and every other
	one's full lowercase (do_capitalize)."

	| lower stream |
	lower := CharacterCollection ___pyCaseMap___: #'___pyLowerMappings___'.
	stream := WriteStream on: Unicode7 new.
	self isEmpty ifTrue: [^ stream contents].
	self
		___pyPut___: self first
		through: (CharacterCollection ___pyCaseMap___: #'___pyTitleMappings___')
		on: stream.
	2 to: self size do: [:index | self ___pyPutLowerAt___: index through: lower on: stream].
	^ stream contents

]

{ #category : 'Grail-Unicode Case' }
CharacterCollection >> ___pyCasefolded___ [
	"str.casefold(): every character's full case folding (do_casefold)."

	^ self ___pyMappedThrough___: (CharacterCollection ___pyCaseMap___: #'___pyCasefoldMappings___')

]

{ #category : 'Grail-Accessors' }
CharacterCollection >> ___pyCodePoints___ [
	"See object >> ___pyCodePoints___.  An Array, not the receiver: the point
	of the shared accessor is that a caller may index it without caring which
	representation it came from."

	| n a |
	n := self size.
	a := Array new: n.
	1 to: n do: [:i | a at: i put: (self at: i) codePoint].
	^ a

]

{ #category : 'Grail-String Methods' }
CharacterCollection >> ___pyFindString___: sub startingAt: start [
	"GemStone's findString:startingAt:, generalised over Grail's str
	representations.  1-based index, or 0 when absent.

	EVERY substring search in this file goes through here.  Handing a
	PyStrSurrogate to the kernel primitive raised an ArgumentTypeError, and an
	ArgumentTypeError is a SMALLTALK error -- uncatchable from Python -- so
	``'abc'.find(name)'' on a surrogateescape'd name took down the caller
	rather than answering -1.  The answer is always ``absent'': a needle
	holding a surrogate cannot occur in a string that has none.

	A non-str needle is passed through UNCHANGED so the kernel still
	complains about it; answering 0 there would turn a type error into a
	silently wrong -1."

	| p m positions |
	sub ___isPyStr___ ifFalse: [^ self findString: sub startingAt: start].
	p := sub ___pyPlainStr___.
	p == nil ifTrue: [^ 0].
	"The kernel primitive is a naive scan: fast per comparison, but its worst
	case is (alignments x needle length), and CPython's suite builds exactly
	that case -- ``('a'*N*2 + 'b'*N + 'a'*N*2).find('a'*N + 'b'*N*2 + 'a'*N)''
	for N up to 10**6 is ~10**12 comparisons, i.e. a hang, where CPython's
	two-way search is linear (string_tests test_adaptive_find,
	test_find_many_lengths).  So bound the primitive's WORST case: past ~2**35
	comparisons (seconds, even at its memcmp speed) switch to the linear-time
	two-way search below, which costs ~0.5s on a 5M-char haystack interpreted.
	Gating on the bound rather than measured work keeps every ordinary search
	on the primitive; the price is that a huge needle in a huge haystack takes
	the interpreted path even when the primitive would have been quick."
	m := p size.
	positions := self size - start - m + 2.
	(m > 1 and: [positions > 0 and: [positions * m > 34359738368]])
		ifTrue: [^ self ___twoWayFind___: p startingAt: start].
	^ self findString: p startingAt: start

]

{ #category : 'Grail-Unicode Case' }
CharacterCollection >> ___pyIsLower___ [
	"str.islower(): no uppercase or titlecase character and at least one
	lowercase one (unicode_islower_impl)."

	| cased |
	cased := false.
	self do: [:character | | codePoint |
		codePoint := character codePoint.
		((CharacterCollection ___pyIsUppercase___: codePoint)
			or: [CharacterCollection ___pyIsTitlecase___: codePoint]) ifTrue: [^ false].
		(CharacterCollection ___pyIsLowercase___: codePoint) ifTrue: [cased := true]].
	^ cased

]

{ #category : 'Grail-Unicode Case' }
CharacterCollection >> ___pyIsTitle___ [
	"str.istitle(): an uppercase or titlecase character only after an uncased
	one, a lowercase one only after a cased one, and at least one of them
	(unicode_istitle_impl)."

	| cased previousIsCased |
	cased := false.
	previousIsCased := false.
	self do: [:character | | codePoint |
		codePoint := character codePoint.
		((CharacterCollection ___pyIsUppercase___: codePoint)
			or: [CharacterCollection ___pyIsTitlecase___: codePoint])
			ifTrue: [
				previousIsCased ifTrue: [^ false].
				previousIsCased := cased := true]
			ifFalse: [
				(CharacterCollection ___pyIsLowercase___: codePoint)
					ifTrue: [
						previousIsCased ifFalse: [^ false].
						previousIsCased := cased := true]
					ifFalse: [previousIsCased := false]]].
	^ cased

]

{ #category : 'Grail-Unicode Case' }
CharacterCollection >> ___pyIsUpper___ [
	"str.isupper(): no lowercase or titlecase character and at least one
	uppercase one (unicode_isupper_impl)."

	| cased |
	cased := false.
	self do: [:character | | codePoint |
		codePoint := character codePoint.
		((CharacterCollection ___pyIsLowercase___: codePoint)
			or: [CharacterCollection ___pyIsTitlecase___: codePoint]) ifTrue: [^ false].
		(CharacterCollection ___pyIsUppercase___: codePoint) ifTrue: [cased := true]].
	^ cased

]

{ #category : 'Grail-Unicode Case' }
CharacterCollection >> ___pyLowered___ [
	"str.lower(): every character's full lowercase, a capital sigma's by its
	Final_Sigma context (do_lower, lower_ucs4)."

	| lower stream |
	lower := CharacterCollection ___pyCaseMap___: #'___pyLowerMappings___'.
	stream := WriteStream on: Unicode7 new.
	1 to: self size do: [:index | self ___pyPutLowerAt___: index through: lower on: stream].
	^ stream contents

]

{ #category : 'Grail-Unicode Case' }
CharacterCollection >> ___pyMappedThrough___: aMap [
	"Every character through aMap, which leaves out the ones it does not change."

	| stream |
	stream := WriteStream on: Unicode7 new.
	self do: [:character | self ___pyPut___: character through: aMap on: stream].
	^ stream contents

]

{ #category : 'Grail-Accessors' }
CharacterCollection >> ___pyPlainStr___ [
	"Itself -- see object >> ___pyPlainStr___."

	^ self

]

{ #category : 'Grail-Unicode Case' }
CharacterCollection >> ___pyPut___: aCharacter through: aMap on: aStream [
	"Put what aMap maps aCharacter to on aStream, or aCharacter itself when aMap
	does not change it."

	(aMap at: aCharacter codePoint otherwise: nil)
		ifNil: [aStream nextPut: aCharacter]
		ifNotNil: [:codePoints | codePoints do: [:each | aStream nextPut: (Character codePoint: each)]]

]

{ #category : 'Grail-Unicode Case' }
CharacterCollection >> ___pyPutLowerAt___: anIndex through: aLowerMap on: aStream [
	"Put the full lowercase of the character at anIndex on aStream; a capital
	sigma's depends on the characters around it (lower_ucs4)."

	| character |
	character := self at: anIndex.
	character codePoint = 16r3A3 ifTrue: [
		^ aStream nextPut: (Character codePoint: (self ___pySigmaLowercaseAt___: anIndex))].
	self ___pyPut___: character through: aLowerMap on: aStream

]

{ #category : 'Grail-Unicode Case' }
CharacterCollection >> ___pySigmaLowercaseAt___: anIndex [
	"The lowercase of the capital sigma at anIndex: final sigma when a cased
	character comes before it and none after it, past any case-ignorable ones
	either way, else small sigma (handle_capital_sigma)."

	| before after |
	before := anIndex - 1.
	[before >= 1 and: [CharacterCollection ___pyIsCaseIgnorable___: (self at: before) codePoint]]
		whileTrue: [before := before - 1].
	(before >= 1 and: [CharacterCollection ___pyIsCased___: (self at: before) codePoint])
		ifFalse: [^ 16r3C3].
	after := anIndex + 1.
	[after <= self size and: [CharacterCollection ___pyIsCaseIgnorable___: (self at: after) codePoint]]
		whileTrue: [after := after + 1].
	(after <= self size and: [CharacterCollection ___pyIsCased___: (self at: after) codePoint])
		ifTrue: [^ 16r3C3].
	^ 16r3C2

]

{ #category : 'Grail-Unicode Case' }
CharacterCollection >> ___pySwapcased___ [
	"str.swapcase(): an uppercase character's full lowercase, a lowercase one's
	full uppercase, and any other character as it is (do_swapcase)."

	| lower upper stream |
	lower := CharacterCollection ___pyCaseMap___: #'___pyLowerMappings___'.
	upper := CharacterCollection ___pyCaseMap___: #'___pyUpperMappings___'.
	stream := WriteStream on: Unicode7 new.
	1 to: self size do: [:index | | character |
		character := self at: index.
		(CharacterCollection ___pyIsUppercase___: character codePoint)
			ifTrue: [self ___pyPutLowerAt___: index through: lower on: stream]
			ifFalse: [
				(CharacterCollection ___pyIsLowercase___: character codePoint)
					ifTrue: [self ___pyPut___: character through: upper on: stream]
					ifFalse: [stream nextPut: character]]].
	^ stream contents

]

{ #category : 'Grail-Unicode Case' }
CharacterCollection >> ___pyTitled___ [
	"str.title(): a character's full titlecase after an uncased one, its full
	lowercase after a cased one (do_title)."

	| lower title stream previousIsCased |
	lower := CharacterCollection ___pyCaseMap___: #'___pyLowerMappings___'.
	title := CharacterCollection ___pyCaseMap___: #'___pyTitleMappings___'.
	stream := WriteStream on: Unicode7 new.
	previousIsCased := false.
	1 to: self size do: [:index | | character |
		character := self at: index.
		previousIsCased
			ifTrue: [self ___pyPutLowerAt___: index through: lower on: stream]
			ifFalse: [self ___pyPut___: character through: title on: stream].
		previousIsCased := CharacterCollection ___pyIsCased___: character codePoint].
	^ stream contents

]

{ #category : 'Grail-Unicode Case' }
CharacterCollection >> ___pyUppered___ [
	"str.upper(): every character's full uppercase (do_upper)."

	^ self ___pyMappedThrough___: (CharacterCollection ___pyCaseMap___: #'___pyUpperMappings___')

]

{ #category : 'Grail-Testing' }
CharacterCollection >> ___reprResult___ [
	"A str is a valid __repr__ result -- see object >> ___reprResult___."

	^ self

]

{ #category : 'Grail-String Methods' }
CharacterCollection >> ___rstripChars___: chars [
	"Helper: strip trailing occurrences of any character in `chars'."

	| size i |
	size := self size.
	i := size.
	[i >= 1 and: [chars includes: (self at: i)]] whileTrue: [
		i := i - 1].
	^ i = size ifTrue: [self] ifFalse: [self copyFrom: 1 to: i]

]

{ #category : 'Grail-Testing' }
CharacterCollection >> ___strResult___ [
	"A str is a valid __str__ result -- see object >> ___strResult___."

	^ self

]

{ #category : 'Grail-String Methods' }
CharacterCollection >> ___twoWayFind___: needle startingAt: start [
	"Crochemore-Perrin two-way search for needle (a plain string, size >= 2)
	at or after the 1-based ``start''.  1-based index, or 0 when absent --
	the contract of findString:startingAt:, which ___pyFindString___ falls
	back from when its naive worst case is unbounded.  O(n + m) time, O(1)
	space; the same algorithm as CPython's fastsearch.h and glibc's memmem.

	Indices below are 0-based offsets (``i'' into needle, ``j'' the
	alignment) and every at: adds 1.  Characters are immediates, so ``=='' is
	an exact code-point test; ordering, needed only for the critical
	factorization, goes through codePoint so the comparison mode cannot
	reorder it."

	| n m fwd rev suffix period periodic j i memory |
	n := self size.
	m := needle size.
	fwd := self ___twoWayMaxSuffix___: needle reversed: false.
	rev := self ___twoWayMaxSuffix___: needle reversed: true.
	(fwd at: 1) > (rev at: 1)
		ifTrue: [suffix := (fwd at: 1) + 1. period := fwd at: 2]
		ifFalse: [suffix := (rev at: 1) + 1. period := rev at: 2].
	"Periodic when the left half recurs one period on."
	periodic := period + suffix <= m.
	i := 1.
	[periodic and: [i <= suffix]] whileTrue: [
		(needle at: i) == (needle at: period + i) ifFalse: [periodic := false].
		i := i + 1].
	j := start - 1.
	periodic ifTrue: [
		memory := 0.
		[j <= (n - m)] whileTrue: [
			i := suffix max: memory.
			[i < m and: [(needle at: i + 1) == (self at: i + j + 1)]]
				whileTrue: [i := i + 1].
			i >= m
				ifTrue: [
					i := suffix - 1.
					[i >= memory and: [(needle at: i + 1) == (self at: i + j + 1)]]
						whileTrue: [i := i - 1].
					i < memory ifTrue: [^ j + 1].
					j := j + period.
					memory := m - period]
				ifFalse: [
					j := j + i - suffix + 1.
					memory := 0]].
		^ 0].
	period := (suffix max: m - suffix) + 1.
	[j <= (n - m)] whileTrue: [
		i := suffix.
		[i < m and: [(needle at: i + 1) == (self at: i + j + 1)]]
			whileTrue: [i := i + 1].
		i >= m
			ifTrue: [
				i := suffix - 1.
				[i >= 0 and: [(needle at: i + 1) == (self at: i + j + 1)]]
					whileTrue: [i := i - 1].
				i < 0 ifTrue: [^ j + 1].
				j := j + period]
			ifFalse: [j := j + i - suffix + 1]].
	^ 0

]

{ #category : 'Grail-String Methods' }
CharacterCollection >> ___twoWayMaxSuffix___: x reversed: reversed [
	"The maximal suffix of x under code-point order (or its reverse), for
	___twoWayFind___'s critical factorization.  Answers { start - 1. period }
	with 0-based offsets, as in Crochemore-Perrin."

	| m ms j k p a b |
	m := x size.
	ms := -1. j := 0. k := 1. p := 1.
	[j + k < m] whileTrue: [
		a := (x at: j + k + 1) codePoint.
		b := (x at: ms + k + 1) codePoint.
		(reversed ifTrue: [a > b] ifFalse: [a < b])
			ifTrue: [
				j := j + k.
				k := 1.
				p := j - ms]
			ifFalse: [
				a = b
					ifTrue: [
						k = p
							ifTrue: [j := j + p. k := 1]
							ifFalse: [k := k + 1]]
					ifFalse: [
						ms := j.
						j := ms + 1.
						k := 1.
						p := 1]]].
	^ Array with: ms with: p

]
