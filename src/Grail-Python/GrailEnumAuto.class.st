"Marker returned by enum.auto(); ___grailBuildMembers: replaces each marker with last-int-value + 1 in declaration order (CPython auto() semantics), so values are per-CLASS 1..n, not a process-global counter."
Class {
	#name : 'GrailEnumAuto',
	#superclass : 'Object',
	#category : 'Grail-Modules'
}
