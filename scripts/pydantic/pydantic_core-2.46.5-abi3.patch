diff --git a/src/input/datetime_access.rs b/src/input/datetime_access.rs
new file mode 100644
index 0000000..ec3e875
--- /dev/null
+++ b/src/input/datetime_access.rs
@@ -0,0 +1,75 @@
+//! The datetime field accessors pydantic_core uses, under either ABI.
+//!
+//! PyO3 provides `PyDateAccess` / `PyTimeAccess` / `PyDeltaAccess` only off the
+//! limited API, where they read the CPython structs directly.  Under `abi3`
+//! the same names are provided here, reading the Python attributes instead --
+//! slower, but the only route that touches no object layout.  Call sites are
+//! unchanged.  (Grail: docs/Support_Pydantic.md, Phase 4 option (b).)
+
+#[cfg(not(Py_LIMITED_API))]
+pub use pyo3::types::{PyDateAccess, PyDeltaAccess, PyTimeAccess};
+
+#[cfg(Py_LIMITED_API)]
+mod limited {
+    use pyo3::intern;
+    use pyo3::prelude::*;
+    use pyo3::types::{PyDate, PyDateTime, PyDelta, PyTime};
+
+    fn field<'py, T: for<'a> FromPyObject<'a, 'py>>(obj: &Bound<'py, PyAny>, name: &Bound<'py, pyo3::types::PyString>) -> T {
+        obj.getattr(name)
+            .and_then(|v| v.extract::<T>().map_err(Into::into))
+            .expect("datetime field")
+    }
+
+    pub trait PyDateAccess {
+        fn get_year(&self) -> i32;
+        fn get_month(&self) -> u8;
+        fn get_day(&self) -> u8;
+    }
+    pub trait PyTimeAccess {
+        fn get_hour(&self) -> u8;
+        fn get_minute(&self) -> u8;
+        fn get_second(&self) -> u8;
+        fn get_microsecond(&self) -> u32;
+        fn get_fold(&self) -> bool;
+    }
+    pub trait PyDeltaAccess {
+        fn get_days(&self) -> i32;
+        fn get_seconds(&self) -> i32;
+        fn get_microseconds(&self) -> i32;
+    }
+
+    macro_rules! date_access {
+        ($t:ty) => {
+            impl PyDateAccess for Bound<'_, $t> {
+                fn get_year(&self) -> i32 { field(self.as_any(), intern!(self.py(), "year")) }
+                fn get_month(&self) -> u8 { field(self.as_any(), intern!(self.py(), "month")) }
+                fn get_day(&self) -> u8 { field(self.as_any(), intern!(self.py(), "day")) }
+            }
+        };
+    }
+    macro_rules! time_access {
+        ($t:ty) => {
+            impl PyTimeAccess for Bound<'_, $t> {
+                fn get_hour(&self) -> u8 { field(self.as_any(), intern!(self.py(), "hour")) }
+                fn get_minute(&self) -> u8 { field(self.as_any(), intern!(self.py(), "minute")) }
+                fn get_second(&self) -> u8 { field(self.as_any(), intern!(self.py(), "second")) }
+                fn get_microsecond(&self) -> u32 { field(self.as_any(), intern!(self.py(), "microsecond")) }
+                fn get_fold(&self) -> bool { field(self.as_any(), intern!(self.py(), "fold")) }
+            }
+        };
+    }
+    date_access!(PyDate);
+    date_access!(PyDateTime);
+    time_access!(PyTime);
+    time_access!(PyDateTime);
+
+    impl PyDeltaAccess for Bound<'_, PyDelta> {
+        fn get_days(&self) -> i32 { field(self.as_any(), intern!(self.py(), "days")) }
+        fn get_seconds(&self) -> i32 { field(self.as_any(), intern!(self.py(), "seconds")) }
+        fn get_microseconds(&self) -> i32 { field(self.as_any(), intern!(self.py(), "microseconds")) }
+    }
+}
+
+#[cfg(Py_LIMITED_API)]
+pub use limited::{PyDateAccess, PyDeltaAccess, PyTimeAccess};
