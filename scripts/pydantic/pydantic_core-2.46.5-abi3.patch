+
+/// `isinstance(attr, types.FunctionType)`.  `PyFunction` is not available
+/// under the limited API, so there it is answered by the type's name.
+#[cfg(not(Py_LIMITED_API))]
+fn is_py_function(attr: &Bound<'_, PyAny>) -> bool {
+    attr.is_instance_of::<PyFunction>()
+}
+
+#[cfg(Py_LIMITED_API)]
+fn is_py_function(attr: &Bound<'_, PyAny>) -> bool {
+    attr.get_type().name().map(|n| n.to_string_lossy() == "function").unwrap_or(false)
+}
