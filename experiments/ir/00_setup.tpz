! Check that GsCompilerClasses was installed by Grail install.sh ...
login
iferr 1 where
run
| cc up |
cc := Globals at: #GsCompilerClasses.
up := System myUserProfile.
(up symbolList includes: cc) ifFalse: [
  Error signal:'GsCompilerClasses should already be in SymbolList if Grail is installed'.
].
^ 'GsCompilerClasses on symbol list for ' , up userId
%
logout
exit
